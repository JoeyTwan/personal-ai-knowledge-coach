# ============================================================
# 个人 AI 知识教练 · 环境变量示例
# 复制本文件为 .env，然后填入真实值
#   cp .env.example .env
# 注意：.env 已被 .gitignore 排除，不会被提交到 GitHub
# ============================================================

# ----- DeepSeek API（LLM 提供方，OpenAI 兼容协议）-----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ----- 数据库（SQLite，零配置；换 Postgres 时改为 postgresql://...）-----
DATABASE_URL=file:./dev.db

# ----- 认证（登录令牌签名密钥，请改成随机长字符串）-----
JWT_SECRET=please-change-me-to-a-long-random-string

# ----- 服务端口 -----
BACKEND_PORT=8787
WEB_PORT=3000
