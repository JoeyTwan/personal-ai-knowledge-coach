// Prisma Schema · 个人 AI 知识教练
// 默认 SQLite（零配置），可切换 Postgres

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  username     String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile         UserProfile?
  knowledges      Knowledge[]
  states          UserKnowledgeState[]
  conversations   ConversationSession[]
  reviewSessions  ReviewSession[]
  recommendations LearningRecommendation[]
  gaps            KnowledgeGap[]
  relations       KnowledgeRelation[]
  insights        AiInsight[]
  materials       Material[]
}

// 一份导入的材料（笔记文档或照片）。原文不保存，只留拆解后的知识清单。
model Material {
  id        String   @id @default(cuid())
  title     String // 材料名，取自文件名或 AI 概括
  kind      String // image | pdf | docx | text
  status    String   @default("active") // active | done | dismissed
  itemCount Int      @default(0)
  // 材料偏大时，AI 只挑最重要的若干条，这里是没被展开的条数
  overflow  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  MaterialItem[]

  @@index([userId, status])
}

// 材料拆出的一条知识要点。它替代原文承载信息量，脱离原文也能继续讨论。
model MaterialItem {
  id       String  @id @default(cuid())
  order    Int
  title    String
  gist     String // 这一条讲了什么，自带信息量
  keyFacts String? // JSON 数组，关键事实与数字
  status   String  @default("todo") // todo | discussing | passed | review
  attempts Int     @default(0) // 答错的次数（点两下不算，只有真答错才计数）
  sessionId String? // 讨论会话
  knowledgeId String? // 过关后收录的知识
  // 逐条过关的步进状态，JSON：{ step, stage, cards, wrong, log }
  // 存下来是为了刷新页面能接着答，也让「答错退一级」由服务端说了算，不靠模型自觉
  askState String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, order])
}

model Knowledge {
  id                String   @id @default(cuid())
  title             String
  coreConclusion    String
  briefExplanation  String?
  detailExplanation String?
  example           String?
  type              String
  status            String   @default("active")
  confidence        Float?
  isOutdated        Boolean  @default(false)
  // 弹幕要点：由 AI 把一条知识拆成的若干条独立短句，JSON 字符串数组
  bullets           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  tags          Tag[]                @relation("KnowledgeTags")
  sources       KnowledgeSource[]
  versions      KnowledgeVersion[]
  states        UserKnowledgeState[]
  relationsFrom KnowledgeRelation[]  @relation("RelationFrom")
  relationsTo   KnowledgeRelation[]  @relation("RelationTo")
}

model KnowledgeRelation {
  id         String   @id @default(cuid())
  type       String
  reason     String?
  confidence Float?
  createdAt  DateTime @default(now())

  fromId String
  toId   String
  from   Knowledge @relation("RelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to     Knowledge @relation("RelationTo", fields: [toId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, type])
}

model KnowledgeSource {
  id         String    @id @default(cuid())
  type       String
  detail     String?
  occurredAt DateTime?
  note       String?
  createdAt  DateTime  @default(now())

  knowledgeId String
  knowledge   Knowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
}

model KnowledgeVersion {
  id                String   @id @default(cuid())
  version           Int
  title             String
  coreConclusion    String
  detailExplanation String?
  changeReason      String?
  sourceNote        String?
  createdAt         DateTime @default(now())

  knowledgeId String
  knowledge   Knowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
}

model Category {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  knowledges Knowledge[]
}

model Tag {
  id         String      @id @default(cuid())
  name       String      @unique
  knowledges Knowledge[] @relation("KnowledgeTags")
}

model UserProfile {
  id                    String   @id @default(cuid())
  occupation            String?
  workDomain            String?
  currentFocus          String?
  primaryKnowledgeAreas String? // JSON
  commonScenarios       String? // JSON
  technicalDepth        String?
  businessLevel         String?
  interests             String? // JSON
  learningGoals         String? // JSON
  deepDiveAreas         String? // JSON
  shallowAreas          String? // JSON
  commonMistakes        String? // JSON
  weakDirections        String? // JSON

  // ===== 我的认知（v2）=====
  identity          String? // 「我是谁」的凝练表达
  currentStage      String? // 当前阶段
  growthGoals       String? // JSON 当前成长目标
  longTermGoals     String? // JSON 长期成长方向
  desiredAbilities  String? // JSON 希望获得的能力
  aiGrowthDirection String? // AI 理解的成长方向
  cognitiveTraits   String? // 认知特点（AI 推断）
  learningStyle     String? // JSON 我的学习方式
  depthPreferences  String? // JSON 各领域希望掌握到什么程度
  growthHistory     String? // JSON 成长轨迹
  growthSummary     String? // 阶段总结
  aiSummary         String? // AI 眼中的我
  aiSummaryAt       DateTime?
  insightUpdatedAt  DateTime?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// AI 对用户的长期判断：内容 + 依据 + 置信度 + 用户确认/纠正
model AiInsight {
  id          String    @id @default(cuid())
  type        String // ai_summary | cognitive_trait | learning_style | depth_preference | growth_direction | map_verdict
  content     String
  evidence    String?
  confidence  Float?
  confirmed   Boolean   @default(false)
  corrected   String?
  correctedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model UserKnowledgeState {
  id               String   @id @default(cuid())
  awareness        Float    @default(0)
  recall           Float    @default(0)
  understanding    Float    @default(0)
  association      Float    @default(0)
  application      Float    @default(0)
  stability        Float    @default(0)
  recommendedDepth String   @default("understand")
  lastReviewedAt   DateTime?
  nextReviewAt     DateTime?
  reviewCount      Int      @default(0)
  forgetRisk       Float?
  updatedAt        DateTime @updatedAt

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeId String
  knowledge   Knowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  @@unique([userId, knowledgeId])
}

model ReviewSession {
  id           String    @id @default(cuid())
  type         String    @default("mixed")
  status       String    @default("in_progress")
  knowledgeIds String // JSON 数组
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  questions Question[]
}

model Question {
  id         String   @id @default(cuid())
  type       String
  prompt     String
  options    String? // JSON（选择题）
  answer     String? // 参考答案 / 评分要点
  difficulty Int      @default(1)
  createdAt  DateTime @default(now())

  sessionId String
  session   ReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  knowledgeId String?
  attempts    QuestionAttempt[]
}

model QuestionAttempt {
  id         String   @id @default(cuid())
  answer     String
  isCorrect  Boolean?
  score      Float?
  feedback   String?
  errorType  String?
  createdAt  DateTime @default(now())

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model LearningRecommendation {
  id           String   @id @default(cuid())
  type         String
  title        String
  detail       String?
  knowledgeIds String? // JSON
  status       String   @default("pending")
  createdAt    DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KnowledgeGap {
  id             String   @id @default(cuid())
  gapDescription String
  recommended    Boolean  @default(false)
  reason         String?
  // 针对该用户的建议掌握深度：概念了解 / 原理级 / 能判断 / 深入
  targetDepth    String?
  // 所属领域（一级或二级分类名），用于知识版图归位
  area           String?
  status         String   @default("open")
  createdAt      DateTime @default(now())

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromKnowledgeId String?
  toKnowledgeId   String?
}

model ConversationSession {
  id         String   @id @default(cuid())
  mode       String   @default("cocreate")
  status     String   @default("active")
  title      String?
  rawContent String?
  messages   String   @default("[]") // JSON 对话流
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
