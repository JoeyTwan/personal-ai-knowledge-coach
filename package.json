{
  "name": "personal-ai-knowledge-coach",
  "version": "0.1.0",
  "private": true,
  "description": "人生知识库：一个长期理解你、检验你是否真正掌握、并主动发现认知缺口的 AI 知识教练",
  "workspaces": [
    "apps/*",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm run dev --workspace @coach/backend",
    "dev:web": "npm run dev --workspace @coach/web",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @coach/backend",
    "db:push": "npm run db:push --workspace @coach/backend",
    "db:migrate": "npm run db:migrate --workspace @coach/backend"
  },
  "engines": {
    "node": ">=18"
  }
}
